# Dependencies, caches and generated output
**/node_modules/
**/vendor/bundle/
**/.expo/
**/.wrangler/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.turbo/

# Local configuration and credentials (examples are safe templates only)
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*cookies*.txt
**/credentials.json
**/service-account*.json

# Local databases, logs, backups and user uploads
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.log
**/*.bak
**/*.dump
**/uploads/*
!**/uploads/.htaccess
!**/uploads/index.html

# Private manuscript and generated extracts
**/manuscript/
**/manuscripts/

# IDE and OS files
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/

# Generated Cloudflare Pages artifact
.pages-output/

# Private retained migration references
.local-backup/
