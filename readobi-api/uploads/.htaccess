# Disable PHP engine in uploads directory to prevent RCE
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent script execution via Handler
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar .cgi .pl .py .sh
SetHandler default-handler

# Prohibit execution of scripts and disable directory listing
Options -ExecCGI -Indexes

# Deny direct access to executable script extensions
<FilesMatch "\.(php|phtml|phar|cgi|pl|sh|bash|py|exe|asp|aspx|jsp|env|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
