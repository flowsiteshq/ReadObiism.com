<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Security & Request Filtering -->
        <security>
            <requestFiltering>
                <!-- Deny direct access to dangerous extensions -->
                <fileExtensions>
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".git" allowed="false" />
                </fileExtensions>
                <!-- Hidden segments -->
                <hiddenSegments>
                    <add segment="src" />
                    <add segment="database" />
                    <add segment="logs" />
                    <add segment=".git" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        <directoryBrowse enabled="false" />
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-XSS-Protection" value="1; mode=block" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
