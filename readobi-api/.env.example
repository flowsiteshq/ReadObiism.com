# ALG Company Backend Environment Configuration
APP_NAME="ALG Company Starter Project"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/alg-company-backend-boilerplate

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alg_company_db
DB_USER=root
DB_PASS=

# JWT Authentication Secret & OAuth
JWT_SECRET=super_secret_alg_company_jwt_token_key_2026
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage Drivers (local, s3, r2)
STORAGE_DRIVER=local
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Email SMTP Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@alg.company
MAIL_FROM_NAME="ALG Studio"

# Payment Gateways (Paystack, Flutterwave, Stripe, PayPal, OPay)
PAYSTACK_PUBLIC_KEY=pk_test_PLACEHOLDER
PAYSTACK_SECRET_KEY=sk_test_PLACEHOLDER
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx-X
STRIPE_PUBLIC_KEY=pk_test_PLACEHOLDER
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_MODE=sandbox
OPAY_MERCHANT_ID=xxxxxxxxxxxxxxxx
OPAY_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPAY_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI & LLM Providers (Groq, OpenAI, Gemini, Anthropic)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# CORS Security Settings
CORS_ALLOW_ORIGIN=*
